@article{JIAN2026103881,
 abstract = {Users’ complex intents in interactions have drawn extensive attention to recommendation systems. Conventional methods focus on disentangling interaction behaviors while involving multimodal signals in item description to aid interest modeling from a semantic auxiliary. Despite effectiveness, those methods display significant limitations in both multimodal semantic extraction capabilities and their capacity to align such features with the downstream recommendation task. To leverage the exceptional semantic extraction advantage of large models, this work investigates the manner to integrate large models’ general semantic knowledge with users’ interactions to promote recommendation. On this point, we propose a large multimodal model-based intent prompting learning (LIP) model to utilize multimodal semantics to enhance interactions and guide fine-grained interest learning. Specifically, item nodes are encoded with their textual and visual descriptions, and user-item interactions are also encoded with textual and visual reviews, therefore, the general semantic knowledge is embedded into the interaction graph structure. Besides, we design multiple semantic intent prompts disentangled from reviews to guide interest learning from semantic graphs, narrowing the gap between general semantic signals and the downstream recommendation task. Experiments on three public datasets show the superior performance of LIP over the state-of-the-art models, demonstrating the effectiveness of LIP in learning fine-grained interests with multimodal semantics and intent prompting.},
 author = {Meng Jian and Ruoxi Li and Tuo Wang and Ge Shi and Lifang Wu},
 doi = {10.1016/j.inffus.2025.103881},
 issn = {1566-2535},
 journal = {Inf. Fusion},
 keywords = {Multimedia recommendation, Pre-trained LMM, Intent prompt, User interest},
 pages = {103881},
 title = {{Large multimodal model-based intent prompting learning for multimedia recommendation}},
 url = {https://www.sciencedirect.com/science/article/pii/S1566253525009431},
 volume = {127},
 year = {2026}
}

